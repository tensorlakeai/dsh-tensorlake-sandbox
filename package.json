{
  "name": "@tensorlake/dsh-sandbox",
  "version": "0.1.0",
  "description": "Tensorlake sandbox execution providers for DeepSeek Harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tensorlakeai/dsh-tensorlake-sandbox.git"
  },
  "homepage": "https://github.com/tensorlakeai/dsh-tensorlake-sandbox#readme",
  "bugs": {
    "url": "https://github.com/tensorlakeai/dsh-tensorlake-sandbox/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/runtime.js",
  "types": "./lib/runtime.d.ts",
  "exports": {
    ".": {
      "types": "./lib/runtime.d.ts",
      "default": "./lib/runtime.js"
    },
    "./runtime": {
      "types": "./lib/runtime.d.ts",
      "default": "./lib/runtime.js"
    },
    "./filesystem": {
      "types": "./lib/filesystem/index.d.ts",
      "default": "./lib/filesystem/index.js"
    },
    "./subprocess": {
      "types": "./lib/subprocess/index.d.ts",
      "default": "./lib/subprocess/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint src tests tsdown.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && publint",
    "prepack": "tsdown"
  },
  "dependencies": {
    "tensorlake": "0.5.103"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-fs": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "js-yaml": "^4.2.0",
    "oxlint": "^1.76.0",
    "publint": "^0.3.21",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vitest": "^4.1.8"
  }
}
